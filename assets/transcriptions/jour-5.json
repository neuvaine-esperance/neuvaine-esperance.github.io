,{"mot":"en","debut":118.22,"fin":118.36},{"mot":"lui.","debut":118.36,"fin":118.98}]},{"section":"E","label":"PRIONS","id":"prions","debut":122.53,"fin":168.855,"chante":false,"nbMots":82,"phrases":[{"debut":122.64,"fin":123.03,"texte":"Prions."},{"debut":123.03,"fin":133.53,"texte":"Seigneur, en ce jour de la neuvaine à ton cœur sacré, donne-nous de voir un l'autre un frère, une sœur à aimer."},{"debut":133.53,"fin":141.25,"texte":"Apprends-nous à le faire humblement, simplement et véritablement."},{"debut":141.25,"fin":149.95,"texte":"A l'occasion de la visite de ton serviteur, le pape Léon XIV, en France et particulièrement en Seine-Saint-Denis,"},{"debut":151.53,"fin":154.21,"texte":"nous te confions les chrétiens et tous les habitants de ce pays."},{"debut":154.21,"fin":164.35,"texte":"Fais grandir en nous le désir de la vie et de l'unité pour que nous la répondions au monde entier."},{"debut":164.35,"fin":166.27,"texte":"Amen."}],"mots":[{"mot":"Prions.","debut":122.64,"fin":123.03},{"mot":"Seigneur,","debut":123.03,"fin":125.08},{"mot":"en","debut":125.08,"fin":125.26},{"mot":"ce","debut":125.26,"fin":125.43},{"mot":"jour","debut":125.43,"fin":125.75},{"mot":"de","debut":125.75,"fin":125.98},{"mot":"la","debut":125.98,"fin":126.07},{"mot":"neuvaine","debut":126.07,"fin":126.71},{"mot":"à","debut":126.71,"fin":126.87},{"mot":"ton","debut":126.87,"fin":127.11},{"mot":"cœur","debut":127.11,"fin":127.51},{"mot":"sacré,","debut":127.51,"fin":128.16},{"mot":"donne-nous","debut":128.16,"fin":129.36},{"mot":"de","debut":129.36,"fin":129.52},{"mot":"voir","debut":129.52,"fin":129.97},{"mot":"un","debut":129.97,"fin":130.23},{"mot":"l'autre","debut":130.23,"fin":130.49},{"mot":"un","debut":130.49,"fin":130.61},{"mot":"frère,","debut":130.61,"fin":131.1},{"mot":"une","debut":131.1,"fin":131.5},{"mot":"sœur","debut":131.5,"fin":132.16},{"mot":"à","debut":132.16,"fin":132.42},{"mot":"aimer.","debut":132.42,"fin":133.53},{"mot":"Apprends-nous","debut":133.53,"fin":135.09}