5.35,"fin":175.21,"texte":"Nous te confions à notre diocèse de Saint-Denis, ses paroisses, ses prêtres, ses consacrés, ses familles, ses jeunes et toutes les personnes qui y vivent."},{"debut":175.21,"fin":181.79,"texte":"Seigneur, fais de nous des bâtissures de fraternité."},{"debut":181.79,"fin":191.07,"texte":"Seigneur Jésus, toi qui nous appelles à vivre comme des frères et des sœurs, viens transformer nos cœurs."},{"debut":192.31,"fin":206.39,"texte":"Apprends-nous à dépasser nos différences, à pardonner, à écouter avant de juger, à accueillir celui qui est différent et à reconnaître ta présence dans chaque personne."},{"debut":208.63,"fin":214.67,"texte":"Que notre diocèse soit une maison ouverte, une communauté où personne ne se sente oublié ou rejeté."},{"debut":214.67,"fin":224.01,"texte":"Que la venue du Pape soit pour nous l'occasion de renouveler notre foi, notre espérance et notre amour de l'Église."},{"debut":224.01,"fin":225.53,"texte":"Amen"}],"mots":[{"mot":"Prions,","debut":137.95,"fin":138.58},{"mot":"Seigneur","debut":138.58,"fin":139.6},{"mot":"Jésus,","debut":139.6,"fin":140.67},{"mot":"aujourd'hui,","debut":140.67,"fin":142.29},{"mot":"nous","debut":142.29,"fin":142.59},{"mot":"te","debut":142.59,"fin":142.74},{"mot":"confions","debut":142.74,"fin":143.27},{"mot":"particulièrement","debut":143.27,"fin":144.42},{"mot":"la","debut":144.42,"fin":144.55},{"mot":"venue","debut":144.55,"fin":144.89},{"mot":"du","debut":144.89,"fin":145.14},{"mot":"Pape","debut":145.14,"fin":145.41},{"mot":"dans","debut":145.41,"fin":145.77},{"mot":"notre","debut":145.77,"fin":146.01},{"mot":"diocèse.","debut":146.01,"fin":146.55},{"mot":"Prépare","debut":146.55,"fin":147.32},{"mot":"les","debut":147.32,"fin":147.59},{"mot":"cœurs","debut":147.59,"fin":148.16},{"mot":"à","debut":148.16,"fin":148.7},{"mot":"cette","debut":148.7,"fin":148.83},{"mot":"rencontre.","debut":148.83,"fin":150.03},{"mot":"Que","debut":150.03,"fin":150.27},{"mot":"sa","debut":150.27,"fin":150.